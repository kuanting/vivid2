// 5-inch freestyle FPV quad for manual flight (vivid2 fly --drone fpv5; docs/manual_flight.md).
// Not a benchmark robot: the pilot plugin's flight controller flies it from a radio or gamepad
// through Project AirSim's external-controller-api hook (patches/projectairsim-pilot-hooks.patch).
//
// Numbers:
//   all-up weight 0.65 kg; motors at (+-0.08, +-0.08) m; 5" (0.127 m) props
//   thrust per motor = C_T * rho * n^2 * D^4 = 0.15*1.225*500^2*0.127^4 ~ 12 N
//   -> thrust/weight ~ 7.5 at sea level; motor time constant 20 ms.
//   fast-physics uses only the root link's mass, so Frame carries the full
//   weight; prop links add inertia only.
// Motor order and spin directions follow PX4 quad-X:
//   0 FR (CCW), 1 RL (CCW), 2 FL (CW), 3 RR (CW).
{
  "physics-type": "fast-physics",
  "links": [
    {
      "name": "Frame",
      "inertial": {
        "mass": 0.65,
        "inertia": {
          "type": "matrix",
          "ixx": 0.0011,
          "iyy": 0.0017,
          "izz": 0.0026
        },
        "aerodynamics": {
          "drag-coefficient": 1.0,
          "type": "geometry",
          "geometry": { "box": { "size": "0.16 0.16 0.05" } }
        }
      },
      "collision": { "restitution": 0.2, "friction": 0.6 },
      "visual": {
        // Project AirSim's /Drone/Quadrotor1 baked at 5-inch size (arms at +-0.089 m) into the
        // pilot plugin's content. The root link stays at scale 1: Project AirSim multiplies
        // child link and camera offsets by the root's scale.
        "geometry": { "type": "unreal_mesh", "name": "/FpvPilot/Drones/SM_Quadrotor1_5in", "scale": "1 1 1" }
      }
    },
    {
      "name": "Prop_FR",
      "inertial": {
        "origin": { "xyz": "0.08 0.08 -0.02", "rpy-deg": "0 0 0" },
        "mass": 0.005,
        "inertia": { "type": "point-mass" },
        "aerodynamics": {
          "drag-coefficient": 0.5,
          "type": "geometry",
          "geometry": { "cylinder": { "radius": 0.0635, "length": 0.01 } }
        }
      },
      "visual": {
        "origin": { "xyz": "0.08 0.08 -0.02", "rpy-deg": "0 0 0" },
        "geometry": { "type": "unreal_mesh", "name": "/Drone/PropellerRed", "scale": "0.55 0.55 0.55" }
      }
    },
    {
      "name": "Prop_RL",
      "inertial": {
        "origin": { "xyz": "-0.08 -0.08 -0.02", "rpy-deg": "0 0 0" },
        "mass": 0.005,
        "inertia": { "type": "point-mass" },
        "aerodynamics": {
          "drag-coefficient": 0.5,
          "type": "geometry",
          "geometry": { "cylinder": { "radius": 0.0635, "length": 0.01 } }
        }
      },
      "visual": {
        "origin": { "xyz": "-0.08 -0.08 -0.02", "rpy-deg": "0 0 0" },
        "geometry": { "type": "unreal_mesh", "name": "/Drone/PropellerWhite", "scale": "0.55 0.55 0.55" }
      }
    },
    {
      "name": "Prop_FL",
      "inertial": {
        "origin": { "xyz": "0.08 -0.08 -0.02", "rpy-deg": "0 0 0" },
        "mass": 0.005,
        "inertia": { "type": "point-mass" },
        "aerodynamics": {
          "drag-coefficient": 0.5,
          "type": "geometry",
          "geometry": { "cylinder": { "radius": 0.0635, "length": 0.01 } }
        }
      },
      "visual": {
        "origin": { "xyz": "0.08 -0.08 -0.02", "rpy-deg": "0 0 0" },
        "geometry": { "type": "unreal_mesh", "name": "/Drone/PropellerRed", "scale": "0.55 0.55 0.55" }
      }
    },
    {
      "name": "Prop_RR",
      "inertial": {
        "origin": { "xyz": "-0.08 0.08 -0.02", "rpy-deg": "0 0 0" },
        "mass": 0.005,
        "inertia": { "type": "point-mass" },
        "aerodynamics": {
          "drag-coefficient": 0.5,
          "type": "geometry",
          "geometry": { "cylinder": { "radius": 0.0635, "length": 0.01 } }
        }
      },
      "visual": {
        "origin": { "xyz": "-0.08 0.08 -0.02", "rpy-deg": "0 0 0" },
        "geometry": { "type": "unreal_mesh", "name": "/Drone/PropellerWhite", "scale": "0.55 0.55 0.55" }
      }
    }
  ],
  "joints": [
    { "id": "Frame_Prop_FR", "type": "fixed", "parent-link": "Frame", "child-link": "Prop_FR", "axis": "0 0 1" },
    { "id": "Frame_Prop_RL", "type": "fixed", "parent-link": "Frame", "child-link": "Prop_RL", "axis": "0 0 1" },
    { "id": "Frame_Prop_FL", "type": "fixed", "parent-link": "Frame", "child-link": "Prop_FL", "axis": "0 0 1" },
    { "id": "Frame_Prop_RR", "type": "fixed", "parent-link": "Frame", "child-link": "Prop_RR", "axis": "0 0 1" }
  ],
  "controller": {
    "id": "PilotFC",
    "airframe-setup": "quadrotor-x",
    "type": "external-controller-api",
    "external-controller-api-settings": {
      "factory": "pilot-fc",
      // the pilot plugin's flight-controller profile
      "fc-profile": "freestyle_5in",
      "name": "5-inch FPV",
      "modes": ["acro", "angle", "horizon"],
      // vivid2 fly adds "air-density-ratio" for the map's altitude
      // ESC command u -> thrust fraction: (1-a)*u + a*u^2. The sim rotor is
      // linear in its command, so the adapter applies this curve.
      "thrust-curve": 0.7,
      "actuator-order": [
        { "id": "Prop_FR_actuator" },
        { "id": "Prop_RL_actuator" },
        { "id": "Prop_FL_actuator" },
        { "id": "Prop_RR_actuator" }
      ]
    }
  },
  "actuators": [
    {
      "name": "Prop_FR_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_FR",
      "origin": { "xyz": "0.08 0.08 -0.02", "rpy-deg": "0 0 0" },
      "rotor-settings": {
        "turning-direction": "counter-clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.15,
        "coeff-of-torque": 0.08,
        "max-rpm": 30000,
        "propeller-diameter": 0.127,
        "smoothing-tc": 0.02
      }
    },
    {
      "name": "Prop_RL_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_RL",
      "origin": { "xyz": "-0.08 -0.08 -0.02", "rpy-deg": "0 0 0" },
      "rotor-settings": {
        "turning-direction": "counter-clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.15,
        "coeff-of-torque": 0.08,
        "max-rpm": 30000,
        "propeller-diameter": 0.127,
        "smoothing-tc": 0.02
      }
    },
    {
      "name": "Prop_FL_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_FL",
      "origin": { "xyz": "0.08 -0.08 -0.02", "rpy-deg": "0 0 0" },
      "rotor-settings": {
        "turning-direction": "clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.15,
        "coeff-of-torque": 0.08,
        "max-rpm": 30000,
        "propeller-diameter": 0.127,
        "smoothing-tc": 0.02
      }
    },
    {
      "name": "Prop_RR_actuator",
      "type": "rotor",
      "enabled": true,
      "parent-link": "Frame",
      "child-link": "Prop_RR",
      "origin": { "xyz": "-0.08 0.08 -0.02", "rpy-deg": "0 0 0" },
      "rotor-settings": {
        "turning-direction": "clock-wise",
        "normal-vector": "0.0 0.0 -1.0",
        "coeff-of-thrust": 0.15,
        "coeff-of-torque": 0.08,
        "max-rpm": 30000,
        "propeller-diameter": 0.127,
        "smoothing-tc": 0.02
      }
    }
  ],
  "sensors": [
    {
      // FPV camera: drives the main viewport (streaming only, no capture).
      // +pitch in rpy-deg tilts the camera up (DownCamera configs use -90): 30 degrees of uptilt.
      "id": "FPV",
      "type": "camera",
      "enabled": true,
      "parent-link": "Frame",
      "capture-interval": 0.03,
      "capture-settings": [
        {
          "image-type": 0,
          "width": 1920,
          "height": 1080,
          "fov-degrees": 120,
          "capture-enabled": false,
          "streaming-enabled": true,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.2
        }
      ],
      // Just ahead of the front prop discs (props at x 0.08, radius 0.064),
      // so the blades stay out of the 120 deg view.
      "origin": { "xyz": "0.15 0.0 -0.04", "rpy-deg": "0 30 0" }
    },
    {
      "id": "Chase",
      "type": "camera",
      "enabled": true,
      "parent-link": "Frame",
      "capture-interval": 0.03,
      "capture-settings": [
        {
          "image-type": 0,
          "width": 1280,
          "height": 720,
          "fov-degrees": 90,
          "capture-enabled": false,
          "streaming-enabled": true,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.2
        }
      ],
      "gimbal": { "lock-roll": true, "lock-pitch": true, "lock-yaw": false },
      "origin": { "xyz": "-2.5 0.0 -0.6", "rpy-deg": "0 -12 0" }
    },
    {
      "id": "IMU1",
      "type": "imu",
      "enabled": true,
      "parent-link": "Frame",
      "accelerometer": {
        "velocity-random-walk": 2.353e-3,
        "tau": 800,
        "bias-stability": 3.53e-4,
        "turn-on-bias": "0 0 0"
      },
      "gyroscope": {
        "angle-random-walk": 8.72644e-5,
        "tau": 500,
        "bias-stability": 2.23014e-5,
        "turn-on-bias": "0 0 0"
      }
    }
  ]
}

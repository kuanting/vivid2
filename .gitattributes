# Unreal binary assets go through Git LFS.
unreal/**/*.uasset filter=lfs diff=lfs merge=lfs -text
unreal/**/*.umap filter=lfs diff=lfs merge=lfs -text
unreal/**/*.png filter=lfs diff=lfs merge=lfs -text
unreal/**/*.r16 filter=lfs diff=lfs merge=lfs -text
unreal/**/*.raw filter=lfs diff=lfs merge=lfs -text
sim_config/maps/**/*.npz filter=lfs diff=lfs merge=lfs -text

# Keep line endings stable across Windows and Linux CI.
* text=auto
*.ps1 text eol=crlf
*.bat text eol=crlf

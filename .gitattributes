# Keep line endings stable across Windows and Linux CI. This rule comes first:
# later lines win, so the binary rules below must override it.
* text=auto
*.ps1 text eol=crlf
*.bat text eol=crlf
# git apply needs this patch byte-exact (LF, like the files it patches)
patches/projectairsim-pilot-hooks.patch text eol=lf

# Unreal binary assets and map data go through Git LFS.
unreal/**/*.uasset filter=lfs diff=lfs merge=lfs -text
unreal/**/*.umap filter=lfs diff=lfs merge=lfs -text
unreal/**/*.png filter=lfs diff=lfs merge=lfs -text
unreal/**/*.r16 filter=lfs diff=lfs merge=lfs -text
unreal/**/*.raw filter=lfs diff=lfs merge=lfs -text
unreal/**/*.fbx filter=lfs diff=lfs merge=lfs -text
sim_config/maps/**/*.npz filter=lfs diff=lfs merge=lfs -text

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VIVID 2 scenario",
  "type": "object",
  "required": ["id", "mission", "scene", "dut_start", "search_area", "targets", "brief", "limits"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "mission": {"type": "string", "enum": ["forest_sar", "wildfire_sar", "landslide_sar", "avalanche_sar", "earthquake_sar", "tsunami_sar"],
                "description": "what the scenario searches in; disaster missions (*_sar but forest/wildfire) may add a damage task (damage)"},
    "description": {"type": "string"},
    "scene": {
      "type": "object",
      "required": ["base", "robot_config"],
      "additionalProperties": false,
      "properties": {
        "base": {"type": "string"},
        "robot_config": {"type": "string"},
        "drone_name": {"type": "string", "default": "Drone1"},
        "camera": {"type": "string", "default": "Payload"},
        "map": {"type": "string", "description": "Unreal map the scenario needs (e.g. BlocksMap, ForestSAR); runs are grouped by map"},
        "map_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actors"],
          "description": "How preflight recognises the map. Default: an actor matching BP_VIVID2Map_<map>.*",
          "properties": {
            "actors": {"type": "array", "minItems": 1, "items": {"type": "string"},
                       "description": "actor-name regexes (full match); each must match an actor in the open level"}
          }
        }
      }
    },
    "dut_start": {
      "type": "object",
      "required": ["ned"],
      "additionalProperties": false,
      "properties": {
        "ned": {"$ref": "#/$defs/vec3"},
        "yaw_deg": {"type": "number", "default": 0}
      }
    },
    "fleet": {
      "type": "object",
      "description": "A team of drones (default: one drone at dut_start). Sweepable, e.g. \"fleet.size\": [1, 2, 4]",
      "additionalProperties": false,
      "properties": {
        "size": {"type": "integer", "minimum": 1, "maximum": 4, "default": 1},
        "spacing_m": {"type": "number", "minimum": 10, "default": 10,
                      "description": "distance between launch pads in the automatic layout around dut_start"},
        "drones": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "description": "explicit launch pads (the first `size` are used) instead of the automatic layout",
          "items": {
            "type": "object", "required": ["ned"], "additionalProperties": false,
            "properties": {"ned": {"$ref": "#/$defs/vec3"}, "yaw_deg": {"type": "number", "default": 0}}
          }
        }
      }
    },
    "comms": {
      "type": "object",
      "description": "Communication: the link to the control team, and the radio between the drones of a distributed team (see vivid2/control.py and vivid2/radio.py)",
      "additionalProperties": false,
      "properties": {
        "control_link": {"type": "boolean", "default": true,
                         "description": "the drones can reach the control team (a field network or satellite): a find counts when reported and the mission is over once everyone has been found, with no flight home. false: no link, the drones must come home and land"},
        "range_m": {"type": "number", "exclusiveMinimum": 0},
        "latency_s": {"type": "number", "minimum": 0, "default": 0.1},
        "bandwidth_kbps": {"type": "number", "exclusiveMinimum": 0},
        "loss": {"type": "number", "minimum": 0, "maximum": 1, "default": 0}
      }
    },
    "search_area": {
      "type": "object",
      "required": ["polygon_ne", "altitude_m"],
      "additionalProperties": false,
      "properties": {
        "polygon_ne": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/vec2"}},
        "altitude_m": {"type": "number", "exclusiveMinimum": 0},
        "altitude_ref": {"type": "string", "enum": ["start", "terrain"], "default": "start",
                         "description": "what altitude_m is measured from: the ground at the start (a survey at one height) or the ground under the drone (a terrain-following survey, for steep ground; one drone only)"},
        "ground_down_m": {"type": "number", "default": 0}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "asset", "ned"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "asset": {"type": "string"},
          "ned": {"$ref": "#/$defs/vec3"},
          "yaw_deg": {"type": "number", "default": 0},
          "scale": {"$ref": "#/$defs/vec3"},
          "label": {"type": "string", "default": "person"},
          "description": {"type": "string"},
          "snap": {"enum": ["ground", "surface"], "default": "ground",
                   "description": "set on the bare ground (default), or on the map's surface model: roofs and water (vivid2 damage build)"},
          "jitter_m": {"type": "number", "minimum": 0, "description": "this target's horizontal jitter, instead of target_jitter_m"}
        }
      }
    },
    "target_jitter_m": {"type": "number", "minimum": 0, "default": 0},
    "distractors": {
      "type": "array",
      "description": "objects that look like targets but aren't (backpacks, tents, red debris); reports near them are false alarms",
      "items": {
        "type": "object",
        "required": ["id", "asset", "ned"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "asset": {"type": "string"},
          "ned": {"$ref": "#/$defs/vec3"},
          "yaw_deg": {"type": "number", "default": 0},
          "scale": {"$ref": "#/$defs/vec3"},
          "description": {"type": "string"}
        }
      }
    },
    "fires": {
      "type": "array",
      "description": "static fires (blueprints in /Game/VIVID2/Fire), spawned like distractors and recorded as fires_visible; not targets (see vivid2/hazards/fire.py)",
      "items": {
        "type": "object",
        "required": ["id", "asset", "ned"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "description": "zero-padded, e.g. Fire01: no id may contain another"},
          "asset": {"type": "string"},
          "ned": {"$ref": "#/$defs/vec3"},
          "yaw_deg": {"type": "number", "description": "the smoke drifts along +X; default: downwind (environment.wind_ned)"},
          "description": {"type": "string"}
        }
      }
    },
    "clues": {
      "type": "array",
      "description": "surface clues (a ski, a backpack...) for the damage task's clues product; spawned like distractors and recorded as clues_visible (see docs/damage.md)",
      "items": {
        "type": "object",
        "required": ["id", "asset", "ned", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "asset": {"type": "string"},
          "ned": {"$ref": "#/$defs/vec3"},
          "yaw_deg": {"type": "number", "default": 0},
          "scale": {"$ref": "#/$defs/vec3"},
          "kind": {"enum": ["ski", "ski_pole", "glove", "backpack", "helmet", "clothing", "vehicle", "other"]},
          "description": {"type": "string"}
        }
      }
    },
    "damage": {
      "type": "object",
      "description": "the damage task: map what the disaster did, besides finding people (docs/damage.md)",
      "required": ["products"],
      "additionalProperties": false,
      "properties": {
        "products": {"type": "array", "minItems": 1, "uniqueItems": true,
                     "items": {"enum": ["areas", "roads", "buildings", "clues"]}},
        "area_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"},
                         "description": "area classes to map (default: every class in the map's ground truth)"},
        "aoi_ne": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/vec2"},
                   "description": "area of interest (default: the search area); must lie inside the search area"},
        "map": {"type": "string", "description": "map whose ground truth to use (default: scene.map)"},
        "buried": {
          "type": "array",
          "description": "people buried out of sight: never targets, they score how well the damage map covers them",
          "items": {
            "type": "object", "required": ["id", "ned"], "additionalProperties": false,
            "properties": {"id": {"type": "string"}, "ned": {"$ref": "#/$defs/vec3"},
                           "building": {"type": "string", "description": "the damaged building they are in"},
                           "description": {"type": "string"}}
          }
        },
        "weights": {"type": "object", "propertyNames": {"enum": ["areas", "roads", "buildings", "clues", "buried"]},
                    "additionalProperties": {"type": "number", "minimum": 0}},
        "clue_tolerance_m": {"type": "number", "exclusiveMinimum": 0, "default": 5}
      }
    },
    "brief": {"type": "string"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time_of_day": {"type": ["string", "null"]},
        "weather": {
          "type": "object",
          "description": "Project AirSim weather effects (WeatherParameter names, lowercase), each 0..1",
          "propertyNames": {"enum": ["rain", "road_wetness", "snow", "road_snow", "maple_leaf", "road_leaf", "dust", "fog"]},
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "wind_ned": {"$ref": "#/$defs/vec3"},
        "sunlight_intensity": {"type": ["number", "null"]},
        "cloud_shadow_strength": {"type": ["number", "null"]}
      }
    },
    "limits": {
      "type": "object",
      "required": ["timeout_s"],
      "additionalProperties": false,
      "properties": {
        "timeout_s": {"type": "number", "exclusiveMinimum": 0},
        "max_speed_mps": {"type": "number", "default": 8},
        "min_agl_m": {"type": "number", "minimum": 0, "default": 0.5,
                      "description": "lowest allowed height above ground while flying; each second below it costs safety points. Stacks may fly this low: only hitting something counts against them otherwise"},
        "geofence_margin_m": {"type": "number", "default": 20},
        "energy_budget_m": {"type": "number", "description": "path-length proxy for battery budget (per drone)"},
        "min_separation_m": {"type": "number", "minimum": 0, "default": 5,
                             "description": "teams: drones closer than this (3D) are penalised in the safety score"},
        "no_fly": {
          "type": "array",
          "description": "fire restriction areas the stack is told about: stay above ceiling_agl_m inside each polygon; time below it costs safety points (no_fly_s)",
          "items": {
            "type": "object",
            "required": ["polygon_ne", "ceiling_agl_m"],
            "additionalProperties": false,
            "properties": {
              "polygon_ne": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/vec2"}},
              "ceiling_agl_m": {"type": "number", "exclusiveMinimum": 0},
              "description": {"type": "string"}
            }
          }
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "localization_tolerance_m": {"type": "number", "default": 10},
        "require_all_targets": {"type": "boolean", "default": true}
      }
    },
    "sweep": {
      "type": "object",
      "description": "dotted-path -> list of values (grid product). 'seeds' is an int count or list.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "vec2": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
  }
}

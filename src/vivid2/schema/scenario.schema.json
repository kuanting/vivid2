{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VIVID 2 scenario",
  "type": "object",
  "required": ["id", "mission", "scene", "dut_start", "search_area", "targets", "brief", "limits"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "mission": {"type": "string", "enum": ["forest_sar", "wildfire_sar", "landslide"]},
    "description": {"type": "string"},
    "scene": {
      "type": "object",
      "required": ["base", "robot_config"],
      "additionalProperties": false,
      "properties": {
        "base": {"type": "string"},
        "robot_config": {"type": "string"},
        "drone_name": {"type": "string", "default": "Drone1"},
        "camera": {"type": "string", "default": "Payload"},
        "map": {"type": "string", "description": "Unreal map the scenario needs (e.g. BlocksMap, ForestSAR); runs are grouped by map"},
        "map_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actors"],
          "description": "How preflight recognises the map. Default: an actor matching BP_VIVID2Map_<map>.*",
          "properties": {
            "actors": {"type": "array", "minItems": 1, "items": {"type": "string"},
                       "description": "actor-name regexes (full match); each must match an actor in the open level"}
          }
        }
      }
    },
    "dut_start": {
      "type": "object",
      "required": ["ned"],
      "additionalProperties": false,
      "properties": {
        "ned": {"$ref": "#/$defs/vec3"},
        "yaw_deg": {"type": "number", "default": 0}
      }
    },
    "search_area": {
      "type": "object",
      "required": ["polygon_ne", "altitude_m"],
      "additionalProperties": false,
      "properties": {
        "polygon_ne": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/vec2"}},
        "altitude_m": {"type": "number", "exclusiveMinimum": 0},
        "ground_down_m": {"type": "number", "default": 0}
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "asset", "ned"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "asset": {"type": "string"},
          "ned": {"$ref": "#/$defs/vec3"},
          "yaw_deg": {"type": "number", "default": 0},
          "scale": {"$ref": "#/$defs/vec3"},
          "label": {"type": "string", "default": "person"},
          "description": {"type": "string"}
        }
      }
    },
    "target_jitter_m": {"type": "number", "minimum": 0, "default": 0},
    "distractors": {
      "type": "array",
      "description": "objects that look like targets but aren't (backpacks, tents, red debris); reports near them are false alarms",
      "items": {
        "type": "object",
        "required": ["id", "asset", "ned"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "asset": {"type": "string"},
          "ned": {"$ref": "#/$defs/vec3"},
          "yaw_deg": {"type": "number", "default": 0},
          "scale": {"$ref": "#/$defs/vec3"},
          "description": {"type": "string"}
        }
      }
    },
    "brief": {"type": "string"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time_of_day": {"type": ["string", "null"]},
        "weather": {
          "type": "object",
          "description": "Project AirSim weather effects (WeatherParameter names, lowercase), each 0..1",
          "propertyNames": {"enum": ["rain", "road_wetness", "snow", "road_snow", "maple_leaf", "road_leaf", "dust", "fog"]},
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "wind_ned": {"$ref": "#/$defs/vec3"},
        "sunlight_intensity": {"type": ["number", "null"]},
        "cloud_shadow_strength": {"type": ["number", "null"]}
      }
    },
    "limits": {
      "type": "object",
      "required": ["timeout_s"],
      "additionalProperties": false,
      "properties": {
        "timeout_s": {"type": "number", "exclusiveMinimum": 0},
        "max_speed_mps": {"type": "number", "default": 8},
        "min_agl_m": {"type": "number", "default": 5},
        "geofence_margin_m": {"type": "number", "default": 20},
        "energy_budget_m": {"type": "number", "description": "path-length proxy for battery budget"}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "localization_tolerance_m": {"type": "number", "default": 10},
        "require_all_targets": {"type": "boolean", "default": true}
      }
    },
    "sweep": {
      "type": "object",
      "description": "dotted-path -> list of values (grid product). 'seeds' is an int count or list.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "vec2": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
  }
}

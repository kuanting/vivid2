// ForestSAR map: two separated hikers at dusk, in clear air or ground fog.
{
  "id": "forest_hiker_02",
  "mission": "forest_sar",
  "description": "Two hikers separated at dusk: one crouching, one lying face down. Fog sweep.",
  "scene": {"base": "scene_forest_sar.jsonc", "robot_config": "robot_vivid_quad.jsonc", "camera": "Payload", "map": "ForestSAR"},
  "dut_start": {"ned": [0, 0, -1], "yaw_deg": 0},
  // 60 m above the start keeps at least 18 m over the treetops (ground -10..+11 m, trees <= 31 m).
  "search_area": {"polygon_ne": [[-200, -150], [200, -150], [200, 150], [-200, 150]], "altitude_m": 60, "ground_down_m": 0},
  "targets": [
    {"id": "Hiker1", "asset": "VIVID2_Hiker_YellowJacket_Crouching", "ned": [140, -90, 0], "yaw_deg": 0,
     "description": "adult, yellow jacket, grey trousers, crouching"},
    {"id": "Hiker2", "asset": "VIVID2_Hiker_BlueHoodie_LyingFront", "ned": [-120, 110, 0], "yaw_deg": 120,
     "description": "teenager, dark blue hoodie, lying face down"}
  ],
  "target_jitter_m": 25,
  // Decoys: a yellow jacket and a blue sleeping bag match the two hikers' colours.
  "distractors": [
    {"id": "Decoy1", "asset": "VIVID2_Decoy_Jacket_Yellow", "ned": [-40, -110, 0], "yaw_deg": 40, "description": "dropped yellow jacket"},
    {"id": "Decoy2", "asset": "VIVID2_Decoy_SleepingBag_Blue", "ned": [-160, -40, 0], "yaw_deg": 15, "description": "blue sleeping bag"},
    {"id": "Decoy3", "asset": "VIVID2_Decoy_Tent_Green", "ned": [60, 90, 0], "yaw_deg": 60, "description": "green dome tent"},
    {"id": "Decoy4", "asset": "VIVID2_Decoy_Tarp_Red", "ned": [0, 60, 0], "yaw_deg": -30, "description": "red tarp"},
    {"id": "Decoy5", "asset": "VIVID2_Decoy_Barrel_Blue", "ned": [170, 40, 0], "yaw_deg": 0, "description": "blue plastic drum"}
  ],
  "brief": "A father (yellow rain jacket) and his teenage son (dark blue hoodie) became separated while descending at dusk. Search for both; either may be crouching or lying down.",
  // Dense fog is part of the test, as in real searches. At dusk the fog lies on the ground: with
  // fog 0.02 or 0.05 only the treetops show from 60 m, while from 20 m the ground and a hiker are
  // visible and from 10 m they are clear (2026-11-03 probes). Finding them means flying low among
  // the trees (crowns up to ~30 m, all with collision).
  "environment": {"time_of_day": "2026-09-28 17:30:00", "weather": {"fog": 0.02}, "wind_ned": [4, 2, 0]},
  "limits": {"timeout_s": 1500, "max_speed_mps": 8, "min_agl_m": 0.5, "geofence_margin_m": 25, "energy_budget_m": 12000},
  "success": {"localization_tolerance_m": 10, "require_all_targets": true},
  "sweep": {"environment.weather.fog": [0.0, 0.02, 0.05], "seeds": 3}
}

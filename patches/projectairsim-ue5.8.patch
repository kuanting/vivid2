diff --git a/unreal/Blocks/Plugins/ProjectAirSim/Source/ProjectAirSim/Private/UnrealCompatibility.h b/unreal/Blocks/Plugins/ProjectAirSim/Source/ProjectAirSim/Private/UnrealCompatibility.h
--- a/unreal/Blocks/Plugins/ProjectAirSim/Source/ProjectAirSim/Private/UnrealCompatibility.h
+++ b/unreal/Blocks/Plugins/ProjectAirSim/Source/ProjectAirSim/Private/UnrealCompatibility.h
@@ -6,6 +6,8 @@
 // Exact supported versions
 #define UE_IS_5_2 (ENGINE_MAJOR_VERSION == 5 && ENGINE_MINOR_VERSION == 2)
 #define UE_IS_5_7 (ENGINE_MAJOR_VERSION == 5 && ENGINE_MINOR_VERSION == 7)
+#define UE_IS_5_8 (ENGINE_MAJOR_VERSION == 5 && ENGINE_MINOR_VERSION == 8)
+#define UE_IS_5_7_OR_LATER (UE_IS_5_7 || UE_IS_5_8)
 
 // Convenience macro
-#define UE_IS_SUPPORTED (UE_IS_5_2 || UE_IS_5_7)
+#define UE_IS_SUPPORTED (UE_IS_5_2 || UE_IS_5_7_OR_LATER)

+                #if UE_IS_5_7_OR_LATER
                     VertexShader->SetParameters(RHICmdList.GetScratchShaderParameters(), View);
                     SetShaderParameters(RHICmdList, VertexShader,
                                         VertexShader.GetVertexShader(),

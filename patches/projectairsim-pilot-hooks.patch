+// Game hook: render the robot at an interpolated pose instead of the
+// latest sim pose, so motion is smooth when the sim step and the frame rate
+// differ.
+static TAutoConsoleVariable<int32> CVarPoseInterp(
+    TEXT("pas.Robot.PoseInterp"), 0,
+    TEXT("1: render robots at a pose interpolated between sim steps "
+         "(non-Unreal physics). 0 (default): latest sim pose."),
+    ECVF_Default);
+
+static TAutoConsoleVariable<float> CVarPoseInterpDelayMs(
+    TEXT("pas.Robot.PoseInterpDelayMs"), -1.0f,
+    TEXT("Render delay behind the newest sim pose in ms. Negative (default): "
+         "1.5 sim steps."),
+    ECVF_Default);
+
+// A jump larger than this between consecutive sim poses is a teleport: the
+// history is cleared and the robot moves without a collision sweep.
+static constexpr float PoseTeleportDistanceM = 2.0f;
+
+void AUnrealRobot::InterpolatePose(projectairsim::Pose& OutPose,
+                                   TimeNano& OutSimNanos) const {
+  const FPoseSample& Newest = PoseHistory[PoseHistoryHead];
+  OutPose = Newest.Pose;
+  OutSimNanos = Newest.SimNanos;
+  if (PoseHistoryCount < 2) return;
+
+  const FPoseSample& Prev =
+      PoseHistory[(PoseHistoryHead - 1 + PoseHistorySize) % PoseHistorySize];
+  const TimeNano Step =
+      FMath::Max<TimeNano>(Newest.SimNanos - Prev.SimNanos, 1);
+  const float DelayMs = CVarPoseInterpDelayMs.GetValueOnAnyThread();
+  const TimeNano Delay = DelayMs < 0.0f
+                             ? Step * 3 / 2
+                             : static_cast<TimeNano>(DelayMs * 1.0e6);
+
+  // Estimate the current sim time from the wall time since the newest sample
+  // arrived (capped so a paused sim freezes on its newest pose).
+  const double SinceNewest =
+      FMath::Clamp(FPlatformTime::Seconds() - Newest.WallSeconds, 0.0, 0.05);
+  const TimeNano RenderTime =
+      Newest.SimNanos + static_cast<TimeNano>(SinceNewest * 1.0e9) - Delay;
+  if (RenderTime >= Newest.SimNanos) return;  // no extrapolation
+
+  for (int32 k = 0; k < PoseHistoryCount - 1; ++k) {
+    const FPoseSample& B =
+        PoseHistory[(PoseHistoryHead - k + PoseHistorySize) % PoseHistorySize];
+    const FPoseSample& A =
+        PoseHistory[(PoseHistoryHead - k - 1 + PoseHistorySize) %
+                    PoseHistorySize];
+    if (RenderTime >= A.SimNanos) {
+      const float Alpha =
+          static_cast<float>(RenderTime - A.SimNanos) /
+          static_cast<float>(FMath::Max<TimeNano>(B.SimNanos - A.SimNanos, 1));
+      OutPose.position =
+          A.Pose.position + (B.Pose.position - A.Pose.position) * Alpha;
+      OutPose.orientation =
+          A.Pose.orientation.slerp(Alpha, B.Pose.orientation);
+      OutSimNanos = RenderTime;
+      return;
+    }
+  }
+
+  // Older than the history: use the oldest sample.
+  const FPoseSample& Oldest =
+      PoseHistory[(PoseHistoryHead - (PoseHistoryCount - 1) + PoseHistorySize) %
+                  PoseHistorySize];
+  OutPose = Oldest.Pose;
+  OutSimNanos = Oldest.SimNanos;
+}

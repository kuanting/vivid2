+void AUnrealScene::PaceSimToWallClock(TimeNano cur_sim_time) {
+  const double now = FPlatformTime::Seconds();
+  const TimeNano step = sim_scene->GetClockSettings().step;
+  if (pacing_wall_start_ < 0.0) {
+    pacing_wall_start_ = now;
+    pacing_sim_start_ = cur_sim_time;
+  }
+  TimeNano target =
+      pacing_sim_start_ +
+      static_cast<TimeNano>((now - pacing_wall_start_) * 1.0e9);
+
+  // After a hitch (breakpoint, level load, slow machine) drop the backlog
+  // instead of fast-forwarding through it.
+  constexpr TimeNano kMaxLagNanos = 100'000'000;
+  if (target - cur_sim_time > kMaxLagNanos) {
+    pacing_wall_start_ = now;
+    pacing_sim_start_ = cur_sim_time;
+    target = cur_sim_time;
+  }
+
+  // Run up to two steps ahead of the wall clock until the next frame.
+  projectairsim::SimClock::Get()->ContinueUntilSimTime(target + 2 * step);
+}

@@ -0,0 +1,133 @@
+// Copyright (C) 2026 K. T. Lai
+//
+// MIT License.
+
+#include "Controllers/ExternalControllerRegistry.h"
+
+#include "HAL/PlatformTime.h"
+#include "Misc/ScopeLock.h"
+
+namespace ProjectAirSimExt {
+
+// ---------------------------------------------------------------------------
+// FRcMailbox
+
+void FRcMailbox::Write(const float* Channels, int32 NumChannels,
+                       double WallSeconds) {
+  FRcFrame& Frame = Buffers[WriteIdx];
+  Frame.Count = FMath::Clamp(NumChannels, 0, 16);
+  for (int32 i = 0; i < Frame.Count; ++i) {
+    Frame.Channels[i] = FMath::Clamp(Channels[i], -1.0f, 1.0f);
+  }
+  for (int32 i = Frame.Count; i < 16; ++i) Frame.Channels[i] = 0.0f;
+  Frame.WallSeconds = WallSeconds;
+
+  // Publish: swap our back buffer with the shared one and mark it dirty.
+  const uint8 Old = Shared.exchange(static_cast<uint8>(WriteIdx | DirtyBit),
+                                    std::memory_order_acq_rel);
+  WriteIdx = Old & IndexMask;
+  bEverWritten.store(true, std::memory_order_release);
+}
+
+bool FRcMailbox::ReadLatest(FRcFrame& Out) {
+  if (!bEverWritten.load(std::memory_order_acquire)) return false;
+  if (Shared.load(std::memory_order_acquire) & DirtyBit) {
+    const uint8 Old = Shared.exchange(ReadIdx, std::memory_order_acq_rel);
+    ReadIdx = Old & IndexMask;
+  }
+  Out = Buffers[ReadIdx];
+  return true;
+}
+
+void FRcMailbox::RequestReset(const float PositionNed[3],
+                              const float OrientationWxyz[4]) {
+  FScopeLock Lock(&ResetLock);
+  for (int i = 0; i < 3; ++i) ResetPos[i] = PositionNed[i];
+  for (int i = 0; i < 4; ++i) ResetQuat[i] = OrientationWxyz[i];
+  bResetPending = true;
+  bResetFlag.store(true, std::memory_order_release);
+}
+
+bool FRcMailbox::ConsumeReset(float PositionNed[3], float OrientationWxyz[4]) {
+  // Fast path: no lock unless a reset was requested.
+  if (!bResetFlag.load(std::memory_order_acquire)) return false;
+  FScopeLock Lock(&ResetLock);
+  if (!bResetPending) return false;
+  for (int i = 0; i < 3; ++i) PositionNed[i] = ResetPos[i];
+  for (int i = 0; i < 4; ++i) OrientationWxyz[i] = ResetQuat[i];
+  bResetPending = false;
+  bResetFlag.store(false, std::memory_order_release);
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// Registry
+
+namespace {
+
+struct FRegistry {
+  FCriticalSection Lock;
+  TMap<FString, FExternalFlightControllerFactory> Factories;
+  TMap<FString, FRcMailboxPtr> Mailboxes;
+};
+
+FRegistry& GetRegistry() {
+  static FRegistry Registry;
+  return Registry;
+}
+
+}  // namespace
+
+FRcMailboxPtr GetOrCreateMailbox(const FString& RobotId) {
+  FRegistry& Registry = GetRegistry();
+  FScopeLock Lock(&Registry.Lock);
+  if (FRcMailboxPtr* Found = Registry.Mailboxes.Find(RobotId)) {
+    return *Found;
+  }
+  FRcMailboxPtr Mailbox = MakeShared<FRcMailbox, ESPMode::ThreadSafe>();
+  Registry.Mailboxes.Add(RobotId, Mailbox);
+  return Mailbox;
+}
+
+FExternalFlightControllerPtr CreateController(const FString& FactoryName,
+                                              const FString& RobotId,
+                                              const FString& SettingsJson) {
+  FExternalFlightControllerFactory Factory;
+  {
+    FRegistry& Registry = GetRegistry();
+    FScopeLock Lock(&Registry.Lock);
+    if (const FExternalFlightControllerFactory* Found =
+            Registry.Factories.Find(FactoryName)) {
+      Factory = *Found;
+    }
+  }
+  if (!Factory) return nullptr;
+  return Factory(RobotId, SettingsJson);
+}
+
+void RegisterControllerFactory(const FString& Name,
+                               FExternalFlightControllerFactory Factory) {
+  FRegistry& Registry = GetRegistry();
+  FScopeLock Lock(&Registry.Lock);
+  Registry.Factories.Add(Name, MoveTemp(Factory));
+}
+
+void UnregisterControllerFactory(const FString& Name) {
+  FRegistry& Registry = GetRegistry();
+  FScopeLock Lock(&Registry.Lock);
+  Registry.Factories.Remove(Name);
+}
+
+void SetRcInput(const FString& RobotId, const float* Channels,
+                int32 NumChannels) {
+  if (Channels == nullptr || NumChannels <= 0) return;
+  GetOrCreateMailbox(RobotId)->Write(Channels, NumChannels,
+                                     FPlatformTime::Seconds());
+}
+
+void RequestReset(const FString& RobotId, const float PositionNed[3],
+                  const float OrientationWxyz[4]) {
+  GetOrCreateMailbox(RobotId)->RequestReset(PositionNed, OrientationWxyz);
+}
+
+}  // namespace ProjectAirSimExt

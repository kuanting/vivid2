+bool LoadJsonc(const FString& Path, nlohmann::json& Out, FString& OutError) {
+  FString Text;
+  if (!FFileHelper::LoadFileToString(Text, *Path)) {
+    OutError = FString::Printf(TEXT("cannot read '%s'"), *Path);
+    return false;
+  }
+  try {
+    Out = nlohmann::json::parse(std::string(TCHAR_TO_UTF8(*Text)), nullptr,
+                                /*allow_exceptions=*/true,
+                                /*ignore_comments=*/true);
+  } catch (const std::exception& Ex) {
+    OutError = FString::Printf(TEXT("cannot parse '%s': %hs"), *Path, Ex.what());
+    return false;
+  }
+  return true;
+}
+
+bool InlineConfig(nlohmann::json& Entry, const char* Key, const FString& BaseDir,
+                  FString& OutError) {
+  if (!Entry.contains(Key) || !Entry[Key].is_string()) return true;
+  const FString Rel = UTF8_TO_TCHAR(Entry[Key].get<std::string>().c_str());
+  const FString Full = FPaths::ConvertRelativePathToFull(BaseDir, Rel);
+  nlohmann::json Sub;
+  if (!LoadJsonc(Full, Sub, OutError)) return false;
+  Entry[Key] = Sub;
+  return true;
+}
+
+}  // namespace
+
+bool AUnrealSimLoader::ResolveSceneConfig(const FString& ScenePath,
+                                          std::string& OutJson,
+                                          FString& OutError) {
+  nlohmann::json Scene;
+  const FString FullPath = FPaths::ConvertRelativePathToFull(ScenePath);
+  if (!LoadJsonc(FullPath, Scene, OutError)) return false;
+  const FString BaseDir = FPaths::GetPath(FullPath);
+
+  if (Scene.contains("actors") && Scene["actors"].is_array()) {
+    for (auto& Actor : Scene["actors"]) {
+      if (Actor.value("type", std::string()) == "robot" &&
+          !InlineConfig(Actor, "robot-config", BaseDir, OutError)) {
+        return false;
+      }
+    }
+  }
+  if (Scene.contains("environment-actors") &&
+      Scene["environment-actors"].is_array()) {
+    for (auto& EnvActor : Scene["environment-actors"]) {
+      if (EnvActor.value("type", std::string()) == "env_actor" &&
+          !InlineConfig(EnvActor, "env-actor-config", BaseDir, OutError)) {
+        return false;
+      }
+    }
+  }
+
+  OutJson = Scene.dump();
+  return true;
+}

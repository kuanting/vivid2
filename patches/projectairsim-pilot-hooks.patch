@@ -0,0 +1,116 @@
+// Copyright (C) 2026 K. T. Lai
+//
+// MIT License.
+//
+// External flight-controller hook for Project AirSim.
+//
+// Lets a game/host module plug its own multirotor controller into the sim
+// physics loop. A robot whose config has
+//
+//   "controller": {
+//     "type": "external-controller-api",
+//     "external-controller-api-settings": {
+//       "factory": "<name registered with RegisterExternalControllerFactory>",
+//       "actuator-order": [ {"id": "Prop_FR_actuator"}, ... ],
+//       ...any other settings, passed through as JSON...
+//     }
+//   }
+//
+// gets an IExternalFlightController created by that factory when the scene
+// loads. Step() runs on the sim thread once per physics step, after physics and
+// sensors and before the actuators read their commands.
+//
+// This header only contains plain data and UE core types. It does not include
+// any SimLibs headers. Host modules must not include SimLibs headers either:
+// SimLibs are static libraries, so a second copy would be linked into the host
+// module, with its own singletons (e.g. SimClock).
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Templates/Function.h"
+#include "Templates/SharedPointer.h"
+
+// Sim state handed to the controller each step. Frames: world NED, body FRD,
+// quaternions are Hamilton (w, x, y, z) rotating body -> NED.
+struct FExtCtrlState {
+  int64 SimTimeNanos = 0;  // sim time of this step
+  int64 DtNanos = 0;       // sim time since the previous step (0 on first)
+
+  // IMU (from the robot's first enabled IMU sensor, with its noise model).
+  // If the robot has no IMU, these are ground truth and bHasImu is false.
+  bool bHasImu = false;
+  float Gyro[3] = {0, 0, 0};   // rad/s, body FRD
+  float Accel[3] = {0, 0, 0};  // specific force m/s^2, body FRD (~(0,0,-g) level)
+
+  // Ground truth kinematics.
+  float OrientationWxyz[4] = {1, 0, 0, 0};
+  float PositionNed[3] = {0, 0, 0};       // m
+  float VelocityNed[3] = {0, 0, 0};       // m/s
+  float AngularVelBody[3] = {0, 0, 0};    // rad/s, body FRD
+
+  // Latest RC frame pushed with SetExternalRcInput().
+  bool bRcValid = false;   // false until the first frame arrives
+  int32 RcCount = 0;
+  float Rc[16] = {0};      // [-1, 1]
+  int64 RcAgeNanos = 0;    // wall time since the frame was pushed
+
+  // Collision reported by Unreal for this robot since the last pose update.
+  bool bCollided = false;
+  float CollisionNormalNed[3] = {0, 0, 0};
+};
+
+// Controller output. Motor[i] is the command for actuator-order[i], [0, 1].
+struct FExtCtrlOutput {
+  static constexpr int32 MaxMotors = 8;
+  int32 NumMotors = 0;
+  float Motor[MaxMotors] = {0};
+};
+
+// Implemented by the host. All methods except the factory run on the sim
+// thread: no UObject access, no allocation in Step().
+class IExternalFlightController {
+ public:
+  virtual ~IExternalFlightController() = default;
+
+  // Scene started. NumMotors = length of actuator-order.
+  virtual void OnBegin(const FString& RobotId, int32 NumMotors) {}
+
+  // One physics step. Write NumMotors commands into Out.
+  virtual void Step(const FExtCtrlState& State, FExtCtrlOutput& Out) = 0;
+
+  // Scene stopped or controller reset.
+  virtual void OnEnd() {}
+  virtual void OnReset() {}
+};
+
+using FExternalFlightControllerPtr =
+    TSharedPtr<IExternalFlightController, ESPMode::ThreadSafe>;
+
+// Creates a controller for a robot. SettingsJson is the
+// "external-controller-api-settings" object. Called on the game thread when a
+// scene loads. Return nullptr to refuse (the robot then gets zero outputs).
+using FExternalFlightControllerFactory = TFunction<FExternalFlightControllerPtr(
+    const FString& RobotId, const FString& SettingsJson)>;
+
+namespace ProjectAirSimExt {
+
+PROJECTAIRSIM_API void RegisterControllerFactory(
+    const FString& Name, FExternalFlightControllerFactory Factory);
+
+PROJECTAIRSIM_API void UnregisterControllerFactory(const FString& Name);
+
+// Push the latest RC channels for a robot (values in [-1, 1], up to 16).
+// Call from one thread only (normally the game thread). Wait-free; the sim
+// thread sees the newest frame at its next step.
+PROJECTAIRSIM_API void SetRcInput(const FString& RobotId, const float* Channels,
+                                  int32 NumChannels);
+
+// Teleport a robot to a pose (NED metres, quaternion wxyz) with zero
+// velocity. Applied on the sim thread at the robot's next controller step.
+// Only works for robots using external-controller-api.
+PROJECTAIRSIM_API void RequestReset(const FString& RobotId,
+                                    const float PositionNed[3],
+                                    const float OrientationWxyz[4]);
+
+}  // namespace ProjectAirSimExt

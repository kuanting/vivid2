+//
+// IController that forwards each physics step to an IExternalFlightController
+// supplied by a host module (see ProjectAirSimExternalController.h).
+
+#pragma once
+
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#include "Controllers/ExternalControllerRegistry.h"
+#include "ProjectAirSimExternalController.h"
+#include "core_sim/actor/robot.hpp"
+#include "core_sim/runtime_components.hpp"
+
+namespace microsoft {
+namespace projectairsim {
+class Imu;
+}  // namespace projectairsim
+}  // namespace microsoft
+
+class FExternalControllerApi : public microsoft::projectairsim::IController {
+ public:
+  static constexpr const char* TypeName = "external-controller-api";
+  static constexpr const char* SettingsKey = "external-controller-api-settings";
+
+  // Impl may be null: the robot then gets zero motor commands (never leave a
+  // robot without a controller, Robot::UpdateActuators does not null-check).
+  FExternalControllerApi(const microsoft::projectairsim::Robot& InRobot,
+                         FExternalFlightControllerPtr InImpl);
+  ~FExternalControllerApi() override;
+
+  // Attach an external controller to every robot in the scene whose
+  // controller type is external-controller-api. Call after SimServer has
+  // loaded the scene and before it starts.
+  static void AttachToScene(microsoft::projectairsim::Scene& Scene);
+
+  // IRuntimeComponent
+  void BeginUpdate() override;
+  void EndUpdate() override;
+  void Reset() override;
+
+  // IController
+  void SetKinematics(
+      const microsoft::projectairsim::Kinematics* InKinematics) override;
+  void Update() override;
+  std::vector<float> GetControlSignals(const std::string& ActuatorId) override;
+  const GimbalState& GetGimbalSignal(const std::string& GimbalId) override;
+
+ private:
+  void ApplyPendingReset();
+
+  microsoft::projectairsim::Robot SimRobot;
+  FExternalFlightControllerPtr Impl;
+  ProjectAirSimExt::FRcMailboxPtr Mailbox;
+  FString RobotId;
+
+  const microsoft::projectairsim::Kinematics* Kinematics = nullptr;
+  microsoft::projectairsim::Imu* ImuSensor = nullptr;
+
+  std::unordered_map<std::string, int> ActuatorIndex;
+  int32 NumMotors = 0;
+
+  std::mutex OutputLock;
+  FExtCtrlOutput Output;
+
+  int64 LastSimNanos = -1;
+  GimbalState DefaultGimbal;
+};
diff --git a/unreal/Blocks/Plugins/ProjectAirSim/Source/ProjectAirSim/Private/Controllers/ExternalControllerRegistry.cpp b/unreal/Blocks/Plugins/ProjectAirSim/Source/ProjectAirSim/Private/Controllers/ExternalControllerRegistry.cpp

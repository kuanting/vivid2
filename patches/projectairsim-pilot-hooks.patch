+// Copyright (C) 2026 K. T. Lai
+//
+// MIT License.
+
+#include "Controllers/ExternalControllerApi.h"
+
+#include <algorithm>
+#include <exception>
+
+#include "HAL/PlatformTime.h"
+#include "UnrealLogger.h"
+#include "core_sim/clock.hpp"
+#include "core_sim/physics_common_types.hpp"
+#include "core_sim/scene.hpp"
+#include "core_sim/sensors/imu.hpp"
+#include "json.hpp"
+
+namespace projectairsim = microsoft::projectairsim;
+using json = nlohmann::json;
+
+FExternalControllerApi::FExternalControllerApi(
+    const projectairsim::Robot& InRobot, FExternalFlightControllerPtr InImpl)
+    : SimRobot(InRobot), Impl(MoveTemp(InImpl)) {
+  RobotId = UTF8_TO_TCHAR(SimRobot.GetID().c_str());
+  Mailbox = ProjectAirSimExt::GetOrCreateMailbox(RobotId);
+
+  DefaultGimbal.roll_lock = false;
+  DefaultGimbal.pitch_lock = false;
+  DefaultGimbal.yaw_lock = false;
+
+  // actuator-order maps output index -> actuator id
+  try {
+    const json Controller = json::parse(SimRobot.GetControllerSettings());
+    const json Settings = Controller.value(SettingsKey, json::object());
+    const json Order = Settings.value("actuator-order", json::array());
+    int Idx = 0;
+    for (const auto& Entry : Order) {
+      if (Idx >= FExtCtrlOutput::MaxMotors) break;
+      ActuatorIndex[Entry.value("id", std::string())] = Idx++;
+    }
+    NumMotors = Idx;
+  } catch (const std::exception& Ex) {
+    UnrealLogger::Log(projectairsim::LogLevel::kError,
+                      TEXT("[external-controller-api] Robot '%s': bad "
+                           "settings: %hs"),
+                      *RobotId, Ex.what());
+  }
+  Output.NumMotors = NumMotors;
+}
+
+FExternalControllerApi::~FExternalControllerApi() = default;
+
+void FExternalControllerApi::AttachToScene(projectairsim::Scene& Scene) {
+  for (const auto& ActorRef : Scene.GetActors()) {
+    if (ActorRef.get().GetType() != projectairsim::ActorType::kRobot) continue;
+    auto& Robot = static_cast<projectairsim::Robot&>(ActorRef.get());
+    if (Robot.GetControllerType() != TypeName) continue;
+
+    const FString Id = UTF8_TO_TCHAR(Robot.GetID().c_str());
+    FString FactoryName;
+    FString SettingsJson = TEXT("{}");
+    try {
+      const json Controller = json::parse(Robot.GetControllerSettings());
+      const json Settings = Controller.value(SettingsKey, json::object());
+      FactoryName = UTF8_TO_TCHAR(Settings.value("factory", std::string()).c_str());
+      SettingsJson = UTF8_TO_TCHAR(Settings.dump().c_str());
+    } catch (const std::exception& Ex) {
+      UnrealLogger::Log(projectairsim::LogLevel::kError,
+                        TEXT("[external-controller-api] Robot '%s': cannot "
+                             "parse controller settings: %hs"),
+                        *Id, Ex.what());
+    }
+
+    FExternalFlightControllerPtr Impl =
+        ProjectAirSimExt::CreateController(FactoryName, Id, SettingsJson);
+    if (Impl.IsValid()) {
+      UnrealLogger::Log(projectairsim::LogLevel::kTrace,
+                        TEXT("external-controller-api: attached '%s' to "
+                             "robot '%s'"),
+                        *FactoryName, *Id);
+    } else {
+      UnrealLogger::Log(projectairsim::LogLevel::kError,
+                        TEXT("external-controller-api: no factory '%s' for "
+                             "robot '%s' (is the host module loaded?). Motors "
+                             "will stay at zero."),
+                        *FactoryName, *Id);
+    }
+    Robot.SetController(std::make_unique<FExternalControllerApi>(Robot, Impl));
+  }
+}
+
+void FExternalControllerApi::BeginUpdate() {
+  // First enabled IMU, if any
+  ImuSensor = nullptr;
+  for (const auto& SensorRef : SimRobot.GetSensors()) {
+    auto& Sensor = SensorRef.get();
+    if (Sensor.GetType() == projectairsim::SensorType::kImu &&
+        Sensor.IsEnabled()) {
+      ImuSensor = static_cast<projectairsim::Imu*>(&Sensor);
+      break;
+    }
+  }
+  LastSimNanos = -1;
+  if (Impl.IsValid()) Impl->OnBegin(RobotId, NumMotors);
+}
+
+void FExternalControllerApi::EndUpdate() {
+  if (Impl.IsValid()) Impl->OnEnd();
+}
+
+void FExternalControllerApi::Reset() {
+  {
+    std::lock_guard<std::mutex> Lock(OutputLock);
+    for (float& M : Output.Motor) M = 0.0f;
+  }
+  LastSimNanos = -1;
+  if (Impl.IsValid()) Impl->OnReset();
+}
+
+void FExternalControllerApi::SetKinematics(
+    const projectairsim::Kinematics* InKinematics) {
+  Kinematics = InKinematics;
+}
+
+void FExternalControllerApi::ApplyPendingReset() {
+  float Pos[3];
+  float Quat[4];
+  if (!Mailbox.IsValid() || !Mailbox->ConsumeReset(Pos, Quat)) return;
+
+  projectairsim::Kinematics NewKin;  // zero twist and accels
+  NewKin.pose.position = projectairsim::Vector3(Pos[0], Pos[1], Pos[2]);
+  NewKin.pose.orientation =
+      projectairsim::Quaternion(Quat[0], Quat[1], Quat[2], Quat[3]).normalized();
+  SimRobot.UpdateKinematics(NewKin);
+  SimRobot.UpdateCollisionInfo(projectairsim::CollisionInfo());
+
+  LastSimNanos = -1;
+  if (Impl.IsValid()) Impl->OnReset();
+}
+
+void FExternalControllerApi::Update() {
+  ApplyPendingReset();
+
+  FExtCtrlState State;
+  const int64 Now = projectairsim::SimClock::Get()->NowSimNanos();
+  State.SimTimeNanos = Now;
+  State.DtNanos = LastSimNanos < 0 ? 0 : Now - LastSimNanos;
+  LastSimNanos = Now;
+
+  if (Kinematics != nullptr) {
+    const auto& Pose = Kinematics->pose;
+    State.OrientationWxyz[0] = Pose.orientation.w();
+    State.OrientationWxyz[1] = Pose.orientation.x();
+    State.OrientationWxyz[2] = Pose.orientation.y();
+    State.OrientationWxyz[3] = Pose.orientation.z();
+    for (int i = 0; i < 3; ++i) {
+      State.PositionNed[i] = Pose.position[i];
+      State.VelocityNed[i] = Kinematics->twist.linear[i];
+      State.AngularVelBody[i] = Kinematics->twist.angular[i];
+      State.Gyro[i] = State.AngularVelBody[i];
+    }
+    // Ground-truth specific force in body frame: R^T * (a - g)
+    const projectairsim::Vector3 Gravity(0.0f, 0.0f, 9.80665f);
+    const projectairsim::Vector3 SpecificForce =
+        Pose.orientation.conjugate() * (Kinematics->accels.linear - Gravity);
+    for (int i = 0; i < 3; ++i) State.Accel[i] = SpecificForce[i];
+  }
+
+  if (ImuSensor != nullptr) {
+    const auto ImuMsg = ImuSensor->getOutput();
+    const auto Gyro = ImuMsg.GetAngularVelocity();
+    const auto Accel = ImuMsg.GetLinearAcceleration();
+    for (int i = 0; i < 3; ++i) {
+      State.Gyro[i] = Gyro[i];
+      State.Accel[i] = Accel[i];
+    }
+    State.bHasImu = true;
+  }
+
+  ProjectAirSimExt::FRcFrame Rc;
+  if (Mailbox.IsValid() && Mailbox->ReadLatest(Rc)) {
+    State.bRcValid = true;
+    State.RcCount = Rc.Count;
+    for (int32 i = 0; i < Rc.Count; ++i) State.Rc[i] = Rc.Channels[i];
+    State.RcAgeNanos = static_cast<int64>(
+        (FPlatformTime::Seconds() - Rc.WallSeconds) * 1.0e9);
+  }
+
+  const auto& Collision = SimRobot.GetCollisionInfo();
+  State.bCollided = Collision.has_collided;
+  for (int i = 0; i < 3; ++i) State.CollisionNormalNed[i] = Collision.normal[i];
+
+  FExtCtrlOutput NewOutput;
+  NewOutput.NumMotors = NumMotors;
+  if (Impl.IsValid()) {
+    Impl->Step(State, NewOutput);
+  }
+  NewOutput.NumMotors = NumMotors;
+  for (int32 i = 0; i < FExtCtrlOutput::MaxMotors; ++i) {
+    const float M = NewOutput.Motor[i];
+    NewOutput.Motor[i] = FMath::IsFinite(M) ? FMath::Clamp(M, 0.0f, 1.0f) : 0.0f;
+  }
+
+  std::lock_guard<std::mutex> Lock(OutputLock);
+  Output = NewOutput;
+}
+
+std::vector<float> FExternalControllerApi::GetControlSignals(
+    const std::string& ActuatorId) {
+  const auto It = ActuatorIndex.find(ActuatorId);
+  if (It == ActuatorIndex.end()) return std::vector<float>(1, 0.0f);
+  std::lock_guard<std::mutex> Lock(OutputLock);
+  return std::vector<float>(1, Output.Motor[It->second]);
+}
+
+const microsoft::projectairsim::IController::GimbalState&
+FExternalControllerApi::GetGimbalSignal(const std::string& GimbalId) {
+  // Not supported: NAN fields mean "no command", so gimbals keep their
+  // configured stabilisation.
+  return DefaultGimbal;
+}

+bool AUnrealSimLoader::ReloadScene(const std::string& SceneJson) {
+  // Same sequence as the LoadScene service (SimServer::SimReloadSceneWithJSON)
+  // but callable from the host.
+  try {
+    SimServer->StopScene();
+    StopUnrealScene();
+    UnloadUnrealScene();
+    SimServer->UnloadScene();
+
+    SimServer->LoadScene(SceneJson);
+    SimServer->RegisterServiceMethods();
+    LoadUnrealScene();
+    StartUnrealScene();
+    SimServer->StartScene();
+    return true;
+  } catch (const std::exception& Exception) {
+    UnrealLogger::Log(projectairsim::LogLevel::kError,
+                      TEXT("[AUnrealSimLoader::ReloadScene()] Exception '%hs'. "
+                           "Loading the default scene."),
+                      Exception.what());
+  } catch (...) {
+    UnrealLogger::Log(projectairsim::LogLevel::kError,
+                      TEXT("[AUnrealSimLoader::ReloadScene()] Unknown "
+                           "exception. Loading the default scene."));
+  }
+
+  try {
+    SimServer->LoadScene();
+    SimServer->RegisterServiceMethods();
+  } catch (...) {
+  }
+  return false;
+}

@@ -0,0 +1,66 @@
+// Copyright (C) 2026 K. T. Lai
+//
+// MIT License.
+//
+// Internal side of ProjectAirSimExternalController.h: factory registry and the
+// per-robot mailboxes (RC input, reset requests) shared between the game
+// thread and the sim thread.
+
+#pragma once
+
+#include <atomic>
+
+#include "CoreMinimal.h"
+#include "HAL/CriticalSection.h"
+#include "ProjectAirSimExternalController.h"
+
+namespace ProjectAirSimExt {
+
+struct FRcFrame {
+  int32 Count = 0;
+  float Channels[16] = {0};
+  double WallSeconds = 0.0;  // FPlatformTime::Seconds() when pushed
+};
+
+// Single-producer / single-consumer triple buffer. Wait-free on both sides.
+class FRcMailbox {
+ public:
+  // Producer (one thread).
+  void Write(const float* Channels, int32 NumChannels, double WallSeconds);
+
+  // Consumer (sim thread). Returns false if nothing was ever written.
+  bool ReadLatest(FRcFrame& Out);
+
+  // Reset request (any thread -> sim thread).
+  void RequestReset(const float PositionNed[3], const float OrientationWxyz[4]);
+  bool ConsumeReset(float PositionNed[3], float OrientationWxyz[4]);
+
+ private:
+  static constexpr uint8 DirtyBit = 0x4;
+  static constexpr uint8 IndexMask = 0x3;
+
+  FRcFrame Buffers[3];
+  std::atomic<uint8> Shared{1};  // index of the shared buffer (+ dirty bit)
+  uint8 WriteIdx = 0;            // owned by the producer
+  uint8 ReadIdx = 2;             // owned by the consumer
+  std::atomic<bool> bEverWritten{false};
+
+  FCriticalSection ResetLock;
+  bool bResetPending = false;
+  float ResetPos[3] = {0, 0, 0};
+  float ResetQuat[4] = {1, 0, 0, 0};
+  std::atomic<bool> bResetFlag{false};
+};
+
+using FRcMailboxPtr = TSharedPtr<FRcMailbox, ESPMode::ThreadSafe>;
+
+// Returns the mailbox for a robot, creating it if needed. Thread-safe.
+FRcMailboxPtr GetOrCreateMailbox(const FString& RobotId);
+
+// Creates a controller with the named factory, or nullptr if the factory is
+// missing or refuses. Thread-safe.
+FExternalFlightControllerPtr CreateController(const FString& FactoryName,
+                                              const FString& RobotId,
+                                              const FString& SettingsJson);
+
+}  // namespace ProjectAirSimExt
